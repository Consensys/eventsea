{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["NODE_ENV"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_EVENTS_FACTORY_CONTRACT_ADDRESS",
        "INFURA_API_KEY",
        "INFURA_API_SECRET",
        "NEXT_PUBLIC_CHAIN_ID",
        "LINEA_TEST_RPC_ENDPOINT",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "PINATA_IPFS_ENDPOINT",
        "PINATA_API_KEY",
        "NEXT_PUBLIC_PINATA_GATEWAY",
        "INFURA_IPFS_ENDPOINT",
        "INFURA_IPFS_GATEWAY",
        "ACCOUNT_PRIVATE_KEY"
      ],
      "dependsOn": ["//#copy-artifacts"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_EVENTS_FACTORY_CONTRACT_ADDRESS",
        "INFURA_API_KEY",
        "INFURA_API_SECRET",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "NEXT_PUBLIC_PINATA_GATEWAY",
        "ACCOUNT_PRIVATE_KEY"
      ],
      "dependsOn": ["//#copy-artifacts"]
    },
    "blockchain#compile": {
      "outputs": ["packages/blockchain/artifacts/**", "packages/blockchain/typechain-types/**"]
    },
    "//#copy-artifacts": {
      "dependsOn": ["blockchain#compile"],
      "outputs": ["apps/web/lib/contracts/**"]
    },
    "blockchain#chain": {},
    "deploy:test": { 
      "cache": false
    },
    "deploy:local": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "cache": false
    }
  }
}
